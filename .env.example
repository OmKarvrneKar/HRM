# Copy this file to ".env" and fill in real values. NEVER commit the .env file.
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Production only (used when DJANGO_DEBUG=False) ---------------------------
# Comma-separated origins trusted for CSRF, e.g. https://hrm.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# The values below default to secure settings in production; override only if
# your deployment sits behind a load balancer / proxy that already handles TLS.
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
