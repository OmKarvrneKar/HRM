# Application Secrets
SECRET_KEY=replace_with_a_secure_random_flask_secret_key_in_production
JWT_SECRET_KEY=replace_with_a_secure_random_jwt_secret_key_in_production
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=480

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/
DATABASE_NAME=office_hrm
HRMS_DATA_DIR=data/storage

# Office Attendance Defaults (Asia/Kolkata)
DEFAULT_TIMEZONE=Asia/Kolkata
OFFICE_START_TIME=10:00
OFFICE_END_TIME=18:00
OFFICE_CUTOFF_TIME=19:00
CUTOFF_INTIMATION_MINUTES=45
LATE_GRACE_MINUTES=0

# Application Server
FLASK_ENV=development
PORT=5000
HOST=0.0.0.0

# Rate Limiting
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Development Flags (Strictly false in production, disabled by default)
DEV_OTP_MODE=false
ENABLE_DEV_ENDPOINTS=false
ENABLE_DEV_TEST_ACCOUNT=false


# Outbound Email & Gmail OTP Delivery (SMTP)
# To enable real email dispatch, provide the company's approved SMTP credentials:
# (e.g. Gmail / Google Workspace SMTP with App Password, AWS SES, SendGrid, etc.)
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=deepaksj.in@gmail.com
SMTP_PASSWORD=your_16_digit_app_password
SMTP_FROM="AI Samrat HRMS <hr@aisamrat.com>"
SMTP_USE_TLS=true